# 复制为 .env 后填写真实值；.env 不进仓库
# 优先级：环境变量 > .env > config/config.yaml

# 必填：LLM API Key（config.yaml 中 llm.api_key_env 指向的就是这个变量名）
DESKHUB_LLM_API_KEY=

# 铜币参考库：Numista API Key（config.yaml 中 coins.numista.api_key_env 指向它）
DESKHUB_NUMISTA_API_KEY=

# 铜币品相评级第一阶段：视觉模型 API Key（config.yaml 中 coin_grade.vision.api_key_env）
DESKHUB_QW_VL_API_KEY=
# 铜币品相评级第二阶段：推理模型复用上面的 DESKHUB_LLM_API_KEY

# 可选：覆盖 config.yaml 中的同名字段
# DESKHUB_LLM_BASE_URL=https://api.example.com/v1
# DESKHUB_LLM_MODEL=deepseek-v4-flash
# DESKHUB_DB_PATH=data/deskhub.db
